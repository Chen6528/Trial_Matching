# --- LLM / embedding providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Supabase (Project Settings -> API) ---
# Use the service-role key on the backend only; never ship it to the frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- App config ---
# Shared secret required by POST /api/ingest (sent as the X-API-Key header).
INGEST_API_KEY=change-me
# Comma-separated allowed origins for CORS (your Vercel URL + localhost).
CORS_ORIGINS=http://localhost:3000

# --- Cost/quality tuning (optional; defaults shown) ---
# Trials reasoned over per /api/match request = number of Sonnet calls (lower = cheaper).
SHORTLIST_SIZE=15
# Prompt 2 thinking depth on Sonnet 4.6: low | medium | high | max (lower = cheaper).
REASONING_EFFORT=low

# --- Model selection (override-able; defaults match the plan) ---
EXTRACTION_MODEL=claude-haiku-4-5
REASONING_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
